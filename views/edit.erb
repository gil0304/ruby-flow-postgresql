<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>投稿の編集 | Ruby Flow デモ</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <h1>投稿の編集</h1>
    <nav><a href="/posts/<%= h @post.id %>">← 詳細へ戻る</a></nav>
  </header>
  <main>
    <% if @post.errors.any? %>
      <div class="errors" role="alert">
        <p>入力内容を確認してください。</p>
        <ul>
          <% @post.errors.full_messages.each do |message| %>
            <li><%= flow_h(:error, message) %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <form method="post" action="/posts/<%= h @post.id %>" class="post-form">
      <label for="title">タイトル（必須・100文字まで）</label>
      <input id="title" name="title" type="text" value="<%= flow_h(:title, @post.title) %>">
      <label for="body">本文（1000文字まで）</label>
      <textarea id="body" name="body" rows="6"><%= flow_h(:body, @post.body) %></textarea>
      <button type="submit" class="button">更新する</button>
    </form>
  </main>
</body>
</html>
